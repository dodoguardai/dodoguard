# Copy this file to .env and replace every placeholder before starting DodoGuard.
# Never commit .env or production credentials.

# Database: the standard container setup uses SQLite. For an external database,
# set DB_TYPE and DATABASE_URL according to the deployment documentation.
DB_TYPE=sqlite

# Generate distinct, high-entropy values, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret

NODE_ENV=development
PORT=15500
HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000

# Enable integrations only after configuring their credentials in your local .env.
EMAIL_ENABLED=false
SLACK_ENABLED=false
WEBHOOK_ENABLED=false

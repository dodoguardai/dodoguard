# Copy this file to .env and replace every value before starting DodoGuard.
# Do not commit .env or send it with a public deployment package.

# Generate each value independently, for example:
# openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Generate separate, strong passwords for the application database user and MySQL root user.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

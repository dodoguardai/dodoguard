{
  "name": "dodoguard",
  "description": "DodoGuard - LLM security testing toolkit",
  "author": "DodoGuard",
  "version": "0.119.0",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiyuFutureAI/dodoguard.git"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "workspaces": [
    "frontend",
    "site"
  ],
  "types": "dist/src/index.d.ts",
  "typings": "dist/src/index.d.ts",
  "files": [
    "dist",
    "scripts/run-dodoguard-cli.cjs",
    "!dist/test",
    "!dist/src/__mocks__"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "dodoguard": "scripts/run-dodoguard-cli.cjs"
  },
  "scripts": {
    "audit:fix": "npm audit fix && npm audit fix --prefix frontend && npm audit fix --prefix site",
    "bin": "dist/src/main.js",
    "build:app": "cross-env NODE_OPTIONS=--max-old-space-size=12288 npm run build --prefix frontend",
    "build:clean": "shx rm -rf dist && shx rm -f tsconfig.build.tsbuildinfo",
    "build:capability-audit": "node scripts/build-capability-audit.cjs",
    "build:cli": "npm run generate-constants && shx rm -rf dist && shx rm -f tsconfig.build.tsbuildinfo && cross-env NODE_OPTIONS=--max-old-space-size=12288 tsc -p tsconfig.build.json && npm run build:capability-audit && shx cp backend/src/*.html dist/src && shx cp backend/src/python/wrapper.py dist/src/python && shx cp backend/src/python/persistent_wrapper.py dist/src/python && shx mkdir -p dist/src/golang && shx cp backend/src/golang/wrapper.go dist/src/golang && shx mkdir -p dist/src/ruby && shx cp backend/src/ruby/wrapper.rb dist/src/ruby && shx cp backend/src/dynamic-import.cjs dist/src && shx rm -rf dist/drizzle && shx cp -r drizzle dist/drizzle && shx mkdir -p dist/src/agent-skills/bundled && shx cp -r backend/src/agent-skills/bundled/. dist/src/agent-skills/bundled/ && shx mkdir -p dist/src/dify-pentest/reports/templates/resources && shx cp backend/src/dify-pentest/reports/templates/resources/*.md dist/src/dify-pentest/reports/templates/resources/ && shx chmod +x dist/src/main.js",
    "build:watch": "cross-env NODE_OPTIONS=--max-old-space-size=12288 tsc --watch -p tsconfig.build.json",
    "build": "npm run generate-constants && shx rm -rf dist && shx rm -f tsconfig.build.tsbuildinfo && cross-env NODE_OPTIONS=--max-old-space-size=12288 tsc -p tsconfig.build.json && npm run build:capability-audit && shx cp backend/src/*.html dist/src && shx cp backend/src/python/wrapper.py dist/src/python && shx cp backend/src/python/persistent_wrapper.py dist/src/python && shx mkdir -p dist/src/golang && shx cp backend/src/golang/wrapper.go dist/src/golang && shx mkdir -p dist/src/ruby && shx cp backend/src/ruby/wrapper.rb dist/src/ruby && shx cp backend/src/dynamic-import.cjs dist/src && shx rm -rf dist/drizzle && shx cp -r drizzle dist/drizzle && shx mkdir -p dist/src/agent-skills/bundled && shx cp -r backend/src/agent-skills/bundled/. dist/src/agent-skills/bundled/ && shx mkdir -p dist/src/dify-pentest/reports/templates/resources && shx cp backend/src/dify-pentest/reports/templates/resources/*.md dist/src/dify-pentest/reports/templates/resources/ && npm run build:app && shx chmod +x dist/src/main.js",
    "dify:vuln": "npx tsx scripts/dify-api-vuln-library.ts",
    "dify:chat-scan": "npx tsx scripts/dify-api-vuln-library.ts scan --profile payloads",
    "fastgpt:vuln": "npx tsx scripts/fastgpt-api-vuln-library.ts",
    "fastgpt:chat-scan": "npx tsx scripts/fastgpt-api-vuln-library.ts scan --profile payloads",
    "n8n:vuln": "npx tsx scripts/n8n-api-vuln-library.ts",
    "n8n:chat-scan": "npx tsx scripts/n8n-api-vuln-library.ts scan --profile payloads",
    "coze:vuln": "npx tsx scripts/coze-api-vuln-library.ts",
    "coze:chat-scan": "npx tsx scripts/coze-api-vuln-library.ts scan --profile payloads",
    "coze:scan-db": "npx tsx scripts/coze-api-vuln-library.ts scan --profile all --persist-hits-db",
    "coze:scan-llm": "npx tsx scripts/coze-api-vuln-library.ts scan --profile all --judge-mode llm",
    "coze:scan-db-llm": "npx tsx scripts/coze-api-vuln-library.ts scan --profile all --judge-mode llm --persist-hits-db",
    "citation:generate": "node ./node_modules/ts-node/dist/bin.js scripts/generateCitation.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node --require tsx/cjs backend/src/migrate.ts",
    "db:studio": "npx drizzle-kit studio",
    "export:dify-config-vulns": "npx tsx scripts/export-dify-config-vulnerabilities.ts",
    "dev:app": "npm run dev --prefix frontend",
    "dev:server": "node ./node_modules/nodemon/bin/nodemon.js --exec \"node ./node_modules/ts-node/dist/bin.js\" -P 1000 backend/src/server/index.ts",
    "dev:mysql": "docker compose -f docker-compose.mysql.yml up -d --wait",
    "dev:mysql:down": "docker compose -f docker-compose.mysql.yml down",
    "dev:with-mysql": "npm run dev:mysql && node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:server\" \"npm run dev:app\"",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:server\" \"npm run dev:app\"",
    "docker:offline": "bash scripts/build-offline-image.sh",
    "desktop:preflight": "node scripts/desktop-preflight.cjs",
    "desktop:build": "node scripts/generate-desktop-icon.cjs && npm run desktop:preflight && npm run build:clean && npm run build",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "desktop:fetch-mysql:win": "node scripts/fetch-mysql-portable-win.cjs",
    "desktop:fetch-mysql:linux": "node scripts/fetch-mysql-portable-linux.cjs",
    "desktop:fetch-mysql:mac": "node scripts/fetch-mysql-portable-mac.cjs",
    "desktop:prepare-bcrypt:win": "node scripts/prepare-bcrypt-native.cjs win32 x64",
    "desktop:prepare-bcrypt:mac": "node scripts/prepare-bcrypt-native.cjs darwin x64",
    "desktop:prepare-bcrypt:linux": "node scripts/prepare-bcrypt-native.cjs linux x64",
    "desktop:dist:win": "npm run desktop:build && npm run desktop:prepare-bcrypt:win && electron-builder --win nsis",
    "desktop:dist:win:bundle": "npm run desktop:fetch-mysql:win && npm run desktop:dist:win",
    "desktop:dist:mac": "npm run desktop:build && npm run desktop:prepare-bcrypt:mac && electron-builder --mac dir --publish never && node scripts/patch-packaged-bcrypt.cjs release/mac/DodoGuard.app darwin x64 && node scripts/create-mac-dmg.cjs",
    "desktop:dist:mac:bundle": "npm run desktop:fetch-mysql:mac && npm run desktop:dist:mac",
    "desktop:dist:mac:noproxy": "npm run desktop:build && node scripts/desktop-electron-builder-no-proxy.cjs --mac dmg",
    "desktop:dist:mac:universal": "npm run desktop:build && electron-builder --mac dmg --universal",
    "desktop:dist:mac:universal:noproxy": "npm run desktop:build && node scripts/desktop-electron-builder-no-proxy.cjs --mac dmg --universal",
    "desktop:dist:linux": "npm run desktop:build && npm run desktop:prepare-bcrypt:linux && electron-builder --linux AppImage deb",
    "desktop:dist:linux:appimage": "npm run desktop:build && npm run desktop:prepare-bcrypt:linux && electron-builder --linux AppImage",
    "desktop:dist:linux:bundle": "npm run desktop:fetch-mysql:linux && npm run desktop:dist:linux:appimage",
    "desktop:dist:linux:noproxy": "npm run desktop:build && node scripts/desktop-electron-builder-no-proxy.cjs --linux AppImage deb",
    "desktop:dist:win:noproxy": "npm run desktop:build && node scripts/desktop-electron-builder-no-proxy.cjs --win nsis",
    "playwright:install": "playwright install chromium",
    "f": "git diff --name-only --diff-filter=ACMRTUXB origin/main | grep -E '\\.(js|jsx|mjs|cjs|ts|tsx|json)$' | xargs npx @biomejs/biome format --write && git diff --name-only --diff-filter=ACMRTUXB origin/main | grep -E '\\.(css|scss|html|md|mdc|mdx|yaml|yml)$' | xargs prettier --write",
    "format:check": "npx @biomejs/biome format && prettier --check '**/*.{css,scss,html,md,mdc,mdx,yaml,yml}'",
    "format": "npx @biomejs/biome format --write . && prettier --write '**/*.{css,scss,html,md,mdc,mdx,yaml,yml}'",
    "generate-constants": "node scripts/generate-constants.js",
    "jsonSchema:generate": "npx -y tsx scripts/generateJsonSchema.ts > site/static/config-schema.json && npx @biomejs/biome format --write site/static/config-schema.json",
    "knip": "knip",
    "l": "git diff --name-only --diff-filter=ACMRTUXB origin/main | grep -E '\\.(js|ts|tsx)$' | xargs npx @biomejs/biome lint --write",
    "lint:site": "npx @biomejs/biome lint site",
    "lint:src": "npx @biomejs/biome lint backend/src",
    "lint:tests": "npx @biomejs/biome lint test",
    "lint": "npm run lint:src",
    "local:web": "npm run dev --prefix frontend",
    "local": "node ./node_modules/ts-node/dist/bin.js --cwdMode --transpileOnly backend/src/main.ts",
    "dodoguard": "node dist/src/main.js",
    "preversion": "command -v gh >/dev/null 2>&1 || (echo \"Error: GitHub CLI required.\" && exit 1) && [ \"$(git rev-parse --abbrev-ref HEAD)\" = \"main\" ] || (echo \"Error: Must be on main branch to version\" && exit 1) && git pull origin main && git checkout -b \"chore/bump-version-$(date +%s)\"",
    "postversion": "npm run citation:generate && git add CITATION.cff && git commit --amend --no-edit",
    "prepublishOnly": "npm run build:clean && npm run build",
    "test:app": "npm run test --prefix frontend",
    "test:integration": "jest --config jest.integration.config.ts integration",
    "test:watch": "jest --watch",
    "test:redteam:integration": "npm run build && ./test/redteam/integration/test.sh",
    "test": "jest",
    "tsc": "cross-env NODE_OPTIONS=--max-old-space-size=12288 tsc",
    "mcp": "node dist/src/main.js mcp",
    "depcheck": "depcheck --ignores=\"@types/*,@biomejs/biome,prettier,shx,concurrently,madge,knip,vite,typescript,tshy\" --ignore-dirs=\"dist,site,examples,node_modules\""
  },

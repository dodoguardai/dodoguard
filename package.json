  "build": {
    "publish": null,
    "appId": "com.dodoguard.desktop",
    "productName": "DodoGuard",
    "afterPack": "scripts/electron-after-pack.cjs",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "frontend/dist/**/*",
      "desktop/**/*",
      "package.json",
      {
        "from": "dist/capability-audit",
        "to": "capability-audit"
      }
    ],
    "extraResources": [
      {
        "from": "dist/drizzle",
        "to": "drizzle"
      },
      {
        "from": "release/dodoguard.sql",
        "to": "dodoguard-offline/dodoguard.sql"
      },
      {
        "from": "build/icon.png",
        "to": "dodoguard-icon.png"
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "desktop/vendor/mysql/win-x64",
          "to": "mysql",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "runAfterFinish": false,
      "include": "build/installer.nsh",
